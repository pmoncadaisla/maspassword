<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Talk to the MasPassword server. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Scan the pairing QR (zxing). Requested at runtime by the scan screen. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Optional biometric gate. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MasPassword">

        <activity
            android:name=".ui.RouterActivity"
            android:exported="true"
            android:theme="@style/Theme.MasPassword">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.LinkActivity" android:exported="false" />
        <activity android:name=".ui.UnlockActivity" android:exported="false" />
        <activity android:name=".ui.HomeActivity" android:exported="false" />
        <activity android:name=".ui.ItemDetailActivity" android:exported="false" />

        <!-- Launched by the system autofill framework through a PendingIntent;
             shows as a dialog over the app being filled. Never exported. -->
        <activity
            android:name=".autofill.AutofillAuthActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.MasPassword.AutofillDialog" />

        <!-- System autofill provider: makes MasPassword selectable under
             Settings > Passwords & accounts > Autofill service. The
             BIND_AUTOFILL_SERVICE permission ensures only the OS can bind. -->
        <service
            android:name=".autofill.MasPasswordAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <!-- Lock the zxing scan screen to portrait (it defaults to landscape). -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="android:screenOrientation" />
    </application>

</manifest>
