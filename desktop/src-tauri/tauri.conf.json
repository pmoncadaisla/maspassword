{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sesamo",
  "version": "1.0.0",
  "identifier": "com.masorange.maspassword",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "launcher",
        "title": "Sésamo",
        "width": 460,
        "height": 640,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "Utility",
    "shortDescription": "Sésamo — zero-knowledge password manager",
    "longDescription": "A native desktop shell for your self-hosted Sésamo vault. Connects to your server and keeps all encryption on-device.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
